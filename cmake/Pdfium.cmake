# Binary provenance and the full license bundle are shipped with the application.
set(SPDF_PDFIUM_VERSION "134.0.6996.0")
set(SPDF_PDFIUM_URL "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/6996/pdfium-win-x64.tgz")
set(SPDF_PDFIUM_SHA256 "83e714c302ceacccf403826d5cb57ea39b77f393d83b8d5781283012774a9378")
set(SPDF_PDFIUM_ARCHIVE "" CACHE FILEPATH "Optional offline copy of the pinned PDFium archive")
set(_pdfium_archive "${CMAKE_BINARY_DIR}/_deps/pdfium-win-x64.tgz")
if(SPDF_PDFIUM_ARCHIVE)
  configure_file("${SPDF_PDFIUM_ARCHIVE}" "${_pdfium_archive}" COPYONLY)
else()
  file(DOWNLOAD "${SPDF_PDFIUM_URL}" "${_pdfium_archive}"
    EXPECTED_HASH "SHA256=${SPDF_PDFIUM_SHA256}" TLS_VERIFY ON SHOW_PROGRESS)
endif()
file(SHA256 "${_pdfium_archive}" _actual_hash)
if(NOT _actual_hash STREQUAL SPDF_PDFIUM_SHA256)
  message(FATAL_ERROR "PDFium archive checksum mismatch")
endif()
set(SPDF_PDFIUM_DIR "${CMAKE_BINARY_DIR}/_deps/pdfium")
file(MAKE_DIRECTORY "${SPDF_PDFIUM_DIR}")
file(ARCHIVE_EXTRACT INPUT "${_pdfium_archive}" DESTINATION "${SPDF_PDFIUM_DIR}")
